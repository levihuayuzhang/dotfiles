{
  "layer": "top",
  "position": "top",
  // "position": "bottom",
  // "position": "left",
  // "position": "right",
  // "height": 1080,
  // "width": 3,
  // "output": "eDP-1",

  // full hyprland
  // "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window"],
  // "modules-center": ["cpu", "memory", "temperature", "network"],
  // "modules-right": ["tray", "pulseaudio", "backlight", "battery", "clock"],
  // simple hyprland
  // "modules-left": ["hyprland/workspaces"],
  // "modules-center": ["clock"],
  // "modules-right": ["tray", "cpu", "memory", "temperature", "network", "pulseaudio", "backlight", "battery"],

  // simple niri
  "modules-left": [
    // "custom/arch",
    "custom/nixos",
    "niri/workspaces",
    "niri/window",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "gamemode",
    // "cava",
    "tray",
    "network",
    "cpu",
    "memory",
    "temperature",
    "custom/fan",
    // "pulseaudio/slider",
    "pulseaudio",
    "backlight",
    "bluetooth",
    // "upower#bluetooth-mouse-mxmaster3",
    "battery",
  ],

  "wlr/taskbar": {
    // "all-outputs": true,
    "format": "{icon} {title} {short_state}",
    // "format": "{icon}",
    "tooltip-format": "{title} | {app_id}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
  },
  "niri/window": {
    // "rotate": 90,
    "icon": true,
  },

  "clock": {
    // "rotate": 90,
    "interval": 1,
    "format": " {:%Y-%m-%d %a %H:%M:%OS} ",
    // "format": "\n{:%y\n%m\n%d\n\n%a\n\n%H\n%M\n%OS}\n",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": " {icon} {percent}% ",
    // "format": " {icon}\n{percent}%\n",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
  },
  "cpu": {
    "interval": 2,
    "format": "  {usage}% ",
    // "format": "\n  \n{usage}%\n",
    "tooltip": true,
    "on-click": "gnome-system-monitor",
  },
  "memory": {
    "interval": 3,
    "format": "  {}% ",
    // "format": "  \n{}%\n",
    "tooltip": true,
    "tooltip-format": "{used}GB/{total}GB",
    "on-click": "gnome-system-monitor",
  },
  "temperature": {
    "interval": 3,
    // "thermal-zone": 2,
    "hwmon-path": [
      "/sys/class/hwmon/hwmon2/temp1_input",
      "/sys/class/hwmon/hwmon3/temp1_input",
      "/sys/class/thermal/thermal_zone0/temp",
    ],
    "critical-threshold": 80,
    "format": " {icon} {temperatureC}󰔄 ",
    "format-critical": "{icon} {temperatureC}󰔄 ",
    // "format": " {icon} \n{temperatureC}󰔄\n",
    // "format-critical": " {icon} \n{temperatureC}󰔄\n",
    "format-icons": ["", "", "󰈸"],
  },
  "custom/fan": {
    "exec": "~/bin/waybar-fan.sh",
    "interval": 3,
    "tooltip": true,
  },
  "tray": {
    // "rotate": 90,
    // "icon-size": 16,
    "spacing": 12,
    "orders": {
      "wechat": 99,
    },
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": " {icon} {capacity}% ",
    "format-warning": " {icon} {capacity}% ",
    "format-critical": " {icon} {capacity}% ",
    "format-charging": "  󱐋 {icon} {capacity}% ",
    "format-plugged": "  {icon} {capacity}% ",
    "format-alt": " {icon}  {time} ",
    "format-full": "  {icon} {capacity}% ",

    // "format": " {icon} \n{capacity}%\n",
    // "format-warning": " {icon} \n{capacity}%\n",
    // "format-critical": " {icon} \n{capacity}%\n",
    // "format-charging": " 󱐋\n{icon}\n{capacity}%\n",
    // "format-plugged": " {icon}\n{capacity}%\n",
    // "format-alt": " {icon} \n{time}\n",
    // "format-full": " {icon}\n{capacity}%\n",

    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}",
  },
  "upower#bluetooth-mouse-mxmaster3": {
    "native-path": "hidpp_battery_5",
    "format": " 󰦋 {percentage}",
    "icon-size": 12,
    "show-icon": true,
    "hide-if-empty": true,
    "tooltip": true,
    "tooltip-spacing": 20,
  },
  "bluetooth": {
    // "rotate": 90,
    "format": "  {status} ",
    "format-connected": "  {device_alias} ",
    "format-connected-battery": "  {device_alias} {device_battery_percentage}% ",

    // "format": "  \n{status}\n",
    // "format-connected": "  \n{device_alias}\n",
    // "format-connected-battery": "  \n{device_battery_percentage}%\n",

    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "network": {
    "interval": 2,
    "format-wifi": " {icon}  {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-ethernet": " {icon}󰌘  {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-linked": "  {ifname} (No IP) ",
    "format-disconnected": "  󰌺  Disconnected ",

    // "format-wifi": "{icon}  \n",
    // "format-ethernet": "{icon} 󰌘 \n",
    // "format-linked": "  \nNo\nIP\n",
    // "format-disconnected": " 󰌺\n",

    "tooltip-format-wifi": " {ifname}  {essid}: {signalStrength}% ",
    "tooltip-format-ethernet": "{ifname} 󰌘  {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "tooltip-format-disconnected": "󰌙 󰌺 Disconnected",
    "format-alt": " {ifname}: {ipaddr}/{cidr}  {bandwidthDownBytes}  {bandwidthUpBytes} ",
  },
  "pulseaudio": {
    "format": " {icon} {volume}% {format_source} ",
    "format-bluetooth": " {icon} {volume}% {format_source} ",
    "format-bluetooth-muted": "  {icon} {format_source} ",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-muted": "  {format_source} ",

    // "format": " {icon} \n{volume}%\n{format_source}\n",
    // "format-bluetooth": "{icon} \n{volume}%\n{format_source}\n",
    // "format-bluetooth-muted": " {icon}\n{format_source}\n",
    // "format-source": "  \n{volume}%\n",
    // "format-source-muted": "  \n",
    // "format-muted": "  \n{format_source}\n",

    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  // "hyprland/workspaces": {
  //     "persistent-workspaces": {
  //          "*": 3 // 5 workspaces by default on every monitor
  //         //  "HDMI-A-1": 3 // but only three on HDMI-A-1
  //     }
  // },
  "cava": {
    "cava_config": "$HOME/.config/cava/waybar_raw.conf",
    "framerate": 60,
    "hide_on_silence": true,
    "autosens": 1,
    //"sensitivity": 100,
    "bars": 30,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": {
      "on-click-right": "mode",
    },
  },
  "gamemode": {
    "format": "{glyph}",
    "format-alt": "{glyph} {count}",
    "glyph": "󰊴",
    "hide-not-running": true,
    "use-icon": true,
    "icon-name": "input-gaming-symbolic",
    "icon-spacing": 4,
    "icon-size": 20,
    "tooltip": true,
    "tooltip-format": "Games running: {count}",
  },
  "custom/arch": {
    "format": "  ",
    // "format": "  \n",
  },
  "custom/nixos": {
    "format": "  ",
  },
}
